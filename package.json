{
  "name": "content-studio",
  "version": "0.1.0",
  "description": "Audio tool for narratives and music used in games",
  "type": "module",
  "private": true,
  "bin": {
    "content-studio": "./bin/content-studio.ts"
  },
  "scripts": {
    "start": "bun bin/content-studio.ts",
    "dev": "bun bin/content-studio.ts --dev --project test/fixtures/sample/content-studio.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run typecheck && bun test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}

{
  "$schema": "https://raw.githubusercontent.com/rmstdope/audio-studio/main/schema/content-studio.schema.json",
  "version": 2,
  "name": "Sample Quest",
  "description": "A tiny project for working on the studio.",
  "partLabel": "Act",
  "parts": [
    {
      "id": "act1",
      "title": "Act I: The Lantern"
    },
    {
      "id": "act2",
      "title": "Act II: The Road"
    },
    {
      "id": "act3",
      "title": "Act III: The Crown"
    }
  ],
  "languages": [
    "en",
    "sv",
    "de"
  ],
  "refresh": {
    "part": "sh tools/refresh.sh {part}",
    "shared": "sh tools/refresh-shared.sh"
  },
  "narration": {
    "characters": "tts/cast.json",
    "paths": {
      "dialog": "tts/{part}/{language}/script.json",
      "cues": "tts/{part}/{language}/cues.json",
      "lock": "tts/{part}/{language}/narration.lock.json",
      "clips": "audio/narration/{part}/{language}",
      "manifest": "audio/narration/{part}/{language}/manifest.json"
    }
  },
  "music": {
    "paths": {
      "loops": "tts/{part}/music.json",
      "stingers": "tts/stingers.json",
      "briefs": "music/briefs.json",
      "lock": "music/music.lock.json",
      "clips": "audio/music",
      "manifest": "audio/music/manifest.json"
    }
  },
  "images": {
    "paths": {
      "list": "tts/{part}/images.json",
      "style": "images/style.json",
      "prompts": "images/prompts.json",
      "lock": "images/images.lock.json",
      "clips": "web/public/images/generated",
      "manifest": "web/public/images/generated/manifest.json"
    }
  },
  "effects": {
    "paths": {
      "list": "tts/effects.json",
      "lock": "audio/effects.lock.json",
      "clips": "audio/effects",
      "manifest": "audio/effects/manifest.json"
    }
  },
  "scenes": {
    "paths": {
      "declarations": "tts/{part}/scenes.json",
      "mix": "web/scenes/{part}.mix.json"
    },
    "loudness": {
      "target": -20,
      "tolerance": 2
    }
  }
}
